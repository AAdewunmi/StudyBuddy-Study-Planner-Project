# Example local-only values. Do not use these credentials in production.

# Django runtime
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-in-real-environments
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database
# Docker Compose web containers should use the `db` service hostname.
# Host-side tools can use localhost instead.
DATABASE_URL=postgres://studybuddy:studybuddy@db:5432/studybuddy_local

# Docker Compose PostgreSQL service
POSTGRES_DB=studybuddy_local
POSTGRES_USER=studybuddy
POSTGRES_PASSWORD=studybuddy
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Docker Compose web service
# docker-compose.yml currently exposes 8000:8000 directly.
# WEB_PORT=8000

# Release metadata
RELEASE_SHA=local

# Render production example
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_SECRET_KEY=provided-by-render-secret
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=studybuddy-django-app.onrender.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://studybuddy-django-app.onrender.com
# DATABASE_URL=provided-by-render-managed-postgresql
# DATABASE_SSL_REQUIRE=true
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_LOG_LEVEL=INFO
# RELEASE_SHA=render-release-sha
